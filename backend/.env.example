# TripManner Backend Environment Variables

# Mock data mode (set to False to use real algorithms/LLM)
USE_MOCK_DATA=True

# DeepSeek LLM Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Database
DATABASE_URL=sqlite:///./tripManner.db

# Security
SECRET_KEY=tripManner-secret-key-change-in-production
SESSION_EXPIRE_HOURS=24
